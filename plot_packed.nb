Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"importSetupWithOffset", "[", 
    RowBox[{
    "paramNames_", ",", "paramTypes_", ",", "paramOffsets_", ",", "dir_", ",",
      "setupFilename_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"byteArray", ",", "paramVal"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"byteArray", "=", 
       RowBox[{"ByteArray", "[", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"dir", "<>", "\"\<param.dat\>\""}], ",", "\"\<Binary\>\""}],
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"paramVal", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ImportByteArray", "[", 
           RowBox[{
            RowBox[{"byteArray", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"paramOffsets", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ";;", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "<", 
                  RowBox[{"Length", "[", "paramTypes", "]"}]}], ",", 
                 RowBox[{"paramOffsets", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"paramTypes", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "//", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], "==", "1"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "paramTypes", "]"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"paramNames", "->", "paramVal"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.909411127940404*^9, 3.909411219882243*^9}, {
   3.909411965912095*^9, 3.909412036769495*^9}, 3.909412095569457*^9, {
