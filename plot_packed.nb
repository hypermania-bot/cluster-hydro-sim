Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "getCoupledInterpolants", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getCoupledInterpolants", "[", 
    RowBox[{"subdir_", ",", "subparam__"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dir", ",", "paramNames", ",", "paramTypes", ",", "paramOffsets", ",", 
       "param", ",", "rList", ",", "gridSize", ",", "lmSize", ",", "tList", 
       ",", "\[Psi]List", ",", "\[Psi]SingleList", ",", "dt\[Psi]SingleList", 
       ",", "tToIdx", ",", "rToIdx", ",", "\[Psi]InterpolantList", ",", 
       "\[Psi]Raw", ",", "\[Psi]All", ",", "dt\[Psi]List", ","}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dir", "=", 
       RowBox[{
        RowBox[{"StringTemplate", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<output/\>\"", "<>",
           "subdir"}], "]"}], "[", "subparam", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"paramNames", "=", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"dir", "<>", "\"\<paramNames.txt\>\""}], ",", 
         "\"\<List\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"paramTypes", "=", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"dir", "<>", "\"\<paramTypes.txt\>\""}], ",", 
         "\"\<List\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"paramOffsets", "=", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"dir", "<>", "\"\<paramOffsets.txt\>\""}], ",", 
         "\"\<List\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FailureQ", "[", "paramOffsets", "]"}], ",", 
         RowBox[{"importSetup", "[", 
          RowBox[{
          "paramNames", ",", "paramTypes", ",", "dir", ",", 
           "\"\<param.dat\>\""}], "]"}], ",", 
         RowBox[{"importSetupWithOffset", "[", 
          RowBox[{
          "paramNames", ",", "paramTypes", ",", "paramOffsets", ",", "dir", 
           ",", "\"\<param.dat\>\""}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"param", "[", "\"\<r_min\>\"", "]"}], "+", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"param", "[", "\"\<r_max\>\"", "]"}], "-", 
             RowBox[{"param", "[", "\"\<r_min\>\"", "]"}]}], 
            RowBox[{
             RowBox[{"param", "[", "\"\<N\>\"", "]"}], "-", "1"}]], 
           RowBox[{"(", 
            RowBox[{"i", "-", 
             FractionBox["1", "2"]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"param", "[", "\"\<N\>\"", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gridSize", "=", 
       RowBox[{
        RowBox[{"param", "[", "\"\<N\>\"", "]"}], "+", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lmSize", "=", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"param", "[", "\"\<l_max\>\"", "]"}], "+", "1"}], ")"}], 
        "2"]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tList", "=", 
       RowBox[{
        RowBox[{"importReal64MultiList", "[", 
         RowBox[{"dir", ",", "\"\<t_list.dat\>\""}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tToIdx", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"FirstPosition", "[", 
         RowBox[{"tList", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", ">", "t"}], "&"}], ")"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rToIdx", "[", "r_", "]"}], ":=", 
       RowBox[{
        RowBox[{"FirstPosition", "[", 
         RowBox[{"rList", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", ">", "r"}], "&"}], ")"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Raw", "=", 
       RowBox[{
        RowBox[{"importComplex64MultiList", "[", 
