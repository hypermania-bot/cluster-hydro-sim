 RowBox[{
  RowBox[{
   RowBox[{"importReal64MultiList", "[", 
    RowBox[{"dir_", ",", "template_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "filenameTemplate", ",", "depth", ",", "dimensions", ",", "imported"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"filenameTemplate", "=", 
       RowBox[{"StringTemplate", "[", "template", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"depth", "=", 
       RowBox[{"StringCount", "[", 
        RowBox[{"template", ",", "\"\<``\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dimensions", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"FileNames", "[", 
             RowBox[{"#", ",", "dir", ",", "1"}], "]"}], "]"}], "&"}], ")"}], 
         "@*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"TemplateApply", "[", 
            RowBox[{"filenameTemplate", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "#"}], ",", "\"\<*\>\"", ",", "0"}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "depth"}], "}"}]}], "]"}]}], "]"}], "&"}], 
          ")"}]}], "/@", 
        RowBox[{"Range", "[", "depth", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"imported", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{
            RowBox[{"dir", "<>", 
             RowBox[{"filenameTemplate", "[", "##", "]"}]}], ",", 
            "\"\<Real64\>\""}], "]"}], "&"}], ",", "dimensions", ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "depth"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"dimensions", ",", "imported"}], "}"}]}]}], 
