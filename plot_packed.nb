Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findPowerLaw", "[", 
    RowBox[{"\[Psi]_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", "t2", "]"}], "//", "Abs"}], "]"}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", "t1", "]"}], "//", "Abs"}], "]"}]}], 
    RowBox[{
